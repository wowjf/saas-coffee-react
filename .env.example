# Bancho Cafe / Brew & Bloom Environment Configuration

# Application
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Security (REQUIRED - generate a strong random secret, e.g. `openssl rand -hex 32`)
# The app refuses to start without this, and docker-compose will error if it is unset.
JWT_SECRET=

# Database (local project MongoDB, see scripts/start-local-mongo.sh)
MONGODB_URI=mongodb://127.0.0.1:27017/cafe_db
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me-strong-password

# CORS Allowed Origins (comma separated). In production, list EXPLICIT domains
# only - the wildcard '*' is rejected at startup. Dev may use '*'.
# Example (production): https://bancho.cafe,https://www.bancho.cafe
ALLOWED_ORIGINS=https://bancho.cafe,https://www.bancho.cafe

# Bootstrap Initial Administrator
# Guvenlik (MP-0.2): kayitta rol atamasi YOKTUR — herkes customer olarak kaydolur.
# Bu e-postalar yalnizca bootstrap admin olusturma ve yonetici rolunden yanlislikla
# dusurulmeyi engelleme korumasinda kullanilir; kayit sirasinda rol vermez.
ENABLE_SEED=true
# Benzersiz bir adres secin; bilinen/sabit adresler (admin@, yonetici@...) kullanmayin.
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.example
# REQUIRED in production (docker-compose refuses to start without it).
# Set a strong, unique password - there is NO default fallback; if left empty
# in local dev, the admin account is simply not created.
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-unique-password
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_SURNAME=User
DEFAULT_MANAGER_EMAILS=admin@yourdomain.example

# VDS deployment scripts (scripts/vds-*.py, deploy.ps1, pull-prod-mongo.ps1,
# start-vds-mongo-tunnel.ps1) — these variables are NOT read by the app itself.
# Set them in your shell or local .env before running those scripts.
VDS_HOST=
VDS_USER=root
VDS_PASS=

# nginx/generate-ssl.sh — Common Name (CN) for the self-signed certificate
# fallback. Prefer a real domain + Let's Encrypt (see README SSL rotation).
SSL_CN=localhost
